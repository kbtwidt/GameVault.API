<Window x:Class="GameVault.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Games Manager"
        Height="550"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Games Manager"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Games List -->

            <DataGrid x:Name="GamesGrid"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="GamesGrid_SelectionChanged"
                      Margin="0,0,15,0">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="40"/>

                    <DataGridTextColumn Header="Title"
                                        Binding="{Binding Title}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Platform"
                                        Binding="{Binding Platform}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Year"
                                        Binding="{Binding ReleaseYear}"
                                        Width="60"/>

                </DataGrid.Columns>

            </DataGrid>

            <!-- Game Details -->

            <StackPanel Grid.Column="1">

                <TextBlock Text="Game Details"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <TextBlock Text="ID"/>
                <TextBox x:Name="txtId"
                         IsReadOnly="True"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Title"/>
                <TextBox x:Name="txtTitle"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Platform"/>
                <TextBox x:Name="txtPlatform"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Genre"/>
                <TextBox x:Name="txtGenre"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Release Year"/>
                <TextBox x:Name="txtYear"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Developer"/>
                <TextBox x:Name="txtDeveloper"
                         Margin="0,5,0,15"/>

                <Button Content="Add Game"
                        Click="AddGame_Click"
                        Height="35"
                        Margin="0,3"/>

                <Button Content="Update Game"
                        Click="UpdateGame_Click"
                        Height="35"
                        Margin="0,3"/>

                <Button Content="Delete Game"
                        Click="DeleteGame_Click"
                        Height="35"
                        Margin="0,3"/>

                <Button Content="Clear Fields"
                        Click="Clear_Click"
                        Height="35"
                        Margin="0,3"/>

                <Button Content="Refresh Games"
                        Click="Refresh_Click"
                        Height="35"
                        Margin="0,3"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>
